+    flexWrap: "wrap",
+    gap: 28,
+    alignItems: "flex-start",
+    justifyContent: "center",
+    padding: "8px 0 32px",
+  },
+  phone: {
+    width: 300,
+    background: "linear-gradient(180deg,#1f2937,#111827)",
+    borderRadius: 28,
