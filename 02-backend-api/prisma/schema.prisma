generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String     @id @default(cuid())
  name         String
  phone        String     @unique
  passwordHash String
  role         Role
  location     String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  offers       Offer[]
  products     Product[]
}

model Product {
  id        String        @id @default(cuid())
  farmerId  String
  name      String
  quantity  Float
  unit      String
  price     Float
  location  String
  quality   String
  imageUrl  String?
  status    ProductStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  offers    Offer[]
  farmer    User          @relation(fields: [farmerId], references: [id])
}

model Offer {
  id          String      @id @default(cuid())
  buyerId     String
  productId   String
  quantity    Float
  price       Float
  totalAmount Float
  status      OfferStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  buyer       User        @relation(fields: [buyerId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  trade       Trade?
}

model Trade {
  id            String             @id @default(cuid())
  offerId       String             @unique
  buyerId       String
  farmerId      String
  productId     String
  quantity      Float
  agreedPrice   Float
  totalAmount   Float
  status        TradeStatus        @default(NEGOTIATING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  payments      Payment[]
  offer         Offer              @relation(fields: [offerId], references: [id])
  statusHistory TradeStatusEntry[]
}

model TradeStatusEntry {
  id      String      @id @default(cuid())
  tradeId String
  status  TradeStatus
  at      DateTime    @default(now())
  trade   Trade       @relation(fields: [tradeId], references: [id])
}

model Payment {
  id             String        @id @default(cuid())
  tradeId        String
  paymentRequest String
  paymentHash    String
  amountMsat     BigInt
  status         PaymentStatus @default(CREATED)
  createdAt      DateTime      @default(now())
  paidAt         DateTime?
  settledAt      DateTime?
  trade          Trade         @relation(fields: [tradeId], references: [id])
}

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum ProductStatus {
  ACTIVE
  DEACTIVATED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TradeStatus {
  NEGOTIATING
  AGREED
  PAYMENT_PENDING
  PAYMENT_LOCKED
  DELIVERY_PENDING
  DELIVERED
  SETTLED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
}
