# JWT signing secret - change in production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Backend port (used by dev server)
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:YOURPASSWORD@localhost:5732/agriflow

# RWF -> millisatoshis for the Lightning layer (contract mock)
MSAT_PER_RWF=10
LIGHTNING_MOCK_MODE=autopay