# JWT signing secret - change in production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Backend port (used by dev server)
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:YOURPASSWORD@localhost:5732/agriflow

# RWF -> millisatoshis for the Lightning layer (contract mock)
MSAT_PER_RWF=10
LIGHTNING_MOCK_MODE=autopay

# Hugging Face router - market predictions (server-only secret).
# Never expose these with a NEXT_PUBLIC_ prefix.
HF_TOKEN=hf_xxx
HF_MODEL=openai/gpt-oss-120b:cerebras
HF_BASE_URL=https://router.huggingface.co/v1
